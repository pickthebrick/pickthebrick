# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local-only marketing agent memory log + generated content library
# (see lib/marketingLog.ts, lib/marketingContent.ts - does not exist/persist
# on Vercel's read-only filesystem, so it's never meant to be deployed)
/data

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local sqlite database
/prisma/dev.db
/prisma/dev.db-journal

# Claude Code local tooling (not part of the app)
/.claude/worktrees/
/.claude/settings.local.json

.vercel
.env*
