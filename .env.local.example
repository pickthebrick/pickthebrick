# Root env - used by the Supabase CLI (via `supabase link`) and scripts/seed-catalog.ts.
# Copy this file to .env.local and fill in values from your Supabase project's
# Settings > API page (https://supabase.com/dashboard/project/_/settings/api).

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets `npm run supabase:link` run non-interactively.
SUPABASE_PROJECT_REF=
