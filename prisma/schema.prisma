// PickTheBrick data model: users/roles, catalog (category -> type -> subtype -> product),
// and the quote/approval workflow (draft -> submitted -> captain_confirmed -> admin_approved -> paid).

generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // Rust-free client - no binary Query Engine at all, queries compile via a
  // TypeScript query compiler instead. Required for the Neon driver adapter
  // (lib/prisma.ts) to actually take effect - without this, Prisma still
  // generates a client that expects the binary engine even when an adapter
  // is passed, which is what caused "Query Engine not found" on Vercel.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A contractor's own access to the free client-quote builder (see
// createContractorQuote in app/actions/quotes.ts) - free by default, capped
// at CONTRACTOR_FREE_QUOTE_LIMIT (lib/contractorPlan.ts) completed quotes,
// then paid once the business has arranged payment (cash for now - see
// setContractorPlan in app/actions/contractors.ts). Not meaningful for any
// other role.
enum ContractorPlan {
  free
  paid
}

enum Role {
  client
  captain
  contractor
  admin
  // Everything a regular admin can do, plus managing admin accounts
  // (create/delete) and receiving job applications - see lib/roles.ts'
  // ADMIN_ROLES helper, which is what every admin-only gate actually checks.
  super_admin
  designer
  marketing
}

enum DesignRequestStatus {
  draft
  submitted
  in_progress
  delivered
}

enum Unit {
  sqm
  lm
  count
}

enum QuoteStatus {
  draft
  submitted
  captain_confirmed
  admin_approved
  paid
}

enum ContractorApplicationStatus {
  pending
  approved
  rejected
  blocked
}

enum DesignerApplicationStatus {
  pending
  approved
  rejected
  blocked
}

enum SiteInspectionStatus {
  requested
  scheduled
  completed
  cancelled
}

enum PaymentClaimStatus {
  pending
  approved
  paid
}

enum TimelineItemStatus {
  unassigned
  assigned
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable - a Google-only account (see googleId below) has no password at
  // all until the person sets one from their Profile page.
  passwordHash String?
  // Set once Google OAuth completes (lib/googleAuth.ts) - the account may
  // still also have a passwordHash if it was originally created that way and
  // later linked (matched by email), or vice versa (password account that
  // later signs in with Google using the same address).
  googleId     String?  @unique
  fullName     String?
  company      String?
  phone        String?
  // Set from the admin Database tab (or the contractor apply form, going
  // forward) - kept distinct from `phone` since a WhatsApp number can differ
  // from the general contact number.
  whatsappNumber String?
  // Set once `whatsappNumber` has been confirmed via the WhatsApp OTP step
  // (lib/phoneVerification.ts) - asked once, at first quote/design-request
  // submission (see submitQuote/submitDesignRequest), never again while set.
  whatsappVerifiedAt DateTime?
  // Set when the client chooses "Verify later" instead of completing the OTP
  // step (saveUnverifiedPhoneAction) - checked alongside whatsappVerifiedAt
  // so a client who's already decided not to verify right now is never
  // re-asked on a later quote/design submission (BuildClient.tsx/
  // FeaturesWizard.tsx used to re-show a mandatory, unskippable version of
  // this step every time, with no way out once WhatsApp OTP delivery failed
  // - this field is what makes the skip decision stick).
  whatsappSkippedAt DateTime?
  // A contractor's own branding, set at registration (apply form) or later
  // from Profile - shown in place of the PickTheBrick logo on their
  // dashboard and while using the quote builder on a contractor-owned quote
  // (see BrandMark.tsx, app/build/BuildClient.tsx's brandLogoUrl prop).
  // Not meaningful for any other role today.
  logoUrl      String?
  // Free vs paid access to the contractor quote builder - see ContractorPlan
  // above. Only meaningful for role: contractor.
  contractorPlan          ContractorPlan @default(free)
  // When contractorPlan last changed (set by setContractorPlan) - shown as
  // "Paid since ..." on the admin Contractor Quotes tab.
  contractorPlanUpdatedAt DateTime?
  // Per-contractor override of the shared free-quote limit (e.g. a pilot
  // partner or VIP relationship gets more than everyone else) - null means
  // "use the default" (see getContractorQuoteLimit in lib/contractorPlan.ts).
  contractorFreeQuotaOverride Int?
  role         Role     @default(client)
  createdAt    DateTime @default(now())

  sessions           Session[]
  passwordResets     PasswordReset[]
  quotesAsClient     Quote[]              @relation("ClientQuotes")
  quotesAsCaptain    Quote[]              @relation("CaptainQuotes")
  quotesAsContractor Quote[]              @relation("ContractorQuotes")
  statusChanges      QuoteStatusHistory[]

  designRequestsAsClient   DesignRequest[] @relation("ClientDesignRequests")
  designRequestsAsDesigner DesignRequest[] @relation("DesignerAssignments")

  contractorApplication ContractorApplication?
  designerApplication   DesignerApplication?
  projectAssignments    ProjectContractor[]
  timelineItemsAsContractor ProjectTimelineItem[]
  timelineItemApplications TimelineItemApplication[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Which login entry point created this session - the public /login form
  // (false) or the hidden /staff-login route (true). A staff-capable account
  // (designer/contractor/marketing/captain/admin/super_admin) that signs in
  // through the public form gets treated as a plain client for the lifetime
  // of that session (see getSession() in lib/auth.ts and proxy.ts) - the same
  // credentials only unlock the role's actual dashboard via /staff-login.
  viaStaffLogin Boolean @default(false)
}

// A pending "forgot password" link - deleted the moment it's used or
// superseded by a newer request (see requestPasswordReset in
// lib/passwordReset.ts), so a row existing at all means it's still live
// (still checked against expiresAt regardless).
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 hash of the raw token that appears only in the emailed link -
  // sha256 rather than PhoneVerification's bcrypt, since this token is a
  // high-entropy random value (not a guessable 6-digit code), so a fast
  // hash with a unique index is enough and keeps the lookup a single query.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A pending WhatsApp OTP challenge - keyed by phone (E.164), not by user,
// since the checkout-time capture step (app/components/PhoneVerifyStep.tsx)
// verifies a number before it's necessarily attached to anything. Looked up
// by lib/phoneVerification.ts; the row is deleted once successfully
// confirmed, or simply expires (no cleanup job needed - expired/stale rows
// are cheap and harmless to leave, checked against on every lookup anyway).
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  // bcrypt hash of the 6-digit code - never store the code itself.
  codeHash  String
  // Capped in confirmPhoneCode() to stop brute-forcing a 6-digit space.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  subtitle  String?
  // Marketer-managed hero image for the homepage "Full Catalog" tile - falls
  // back to on-brand placeholder art (see CategoryArt.tsx) until set.
  imageUrl  String?
  unit      Unit
  highlight String?
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)
  // What PickTheBrick pays a contractor is always less than what it sells
  // this category's work for - the gap between buy and sell price is the
  // business's margin. Adjustable per category by the super admin only (see
  // app/admin/contractor-pricing); every price a contractor sees (open job
  // values, payment claim amounts) is the client sell price reduced by this
  // percent. Defaults to 15% across every category.
  contractorReductionPercent Int @default(15)
  types     Type[]

  applications ContractorApplicationCategory[]
  quoteItems   QuoteItem[]
  projectContractors ProjectContractor[]
  timelineItems ProjectTimelineItem[]
}

model Type {
  id         String    @id @default(cuid())
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  sortOrder  Int       @default(0)
  subtypes   Subtype[]

  timelineItems ProjectTimelineItem[]
  applications  ContractorApplicationType[]

  @@unique([categoryId, key])
}

model Subtype {
  id        String    @id @default(cuid())
  typeId    String
  type      Type      @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([typeId, key])
}

model Product {
  id          String  @id @default(cuid())
  subtypeId   String
  subtype     Subtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  name        String
  rate        Float
  // Kept for schema/history compatibility only - pricing is a single
  // all-inclusive rate now, so this is always 0 for every product going
  // forward and is no longer read anywhere in the app.
  installRate Float   @default(0)
  description String?
  unit        Unit?
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  // Per-product override so the client-facing Size/Color sections can be
  // hidden even when rows exist (e.g. sourced data isn't a fit) - not every
  // product has real size/color variation, unlike the old hardcoded SIZES
  // list that showed on every product regardless.
  sizeVariantsEnabled  Boolean @default(true)
  colorVariantsEnabled Boolean @default(true)

  quoteItems   QuoteItem[]
  images       ProductImage[]
  colorOptions ProductColorOption[]
  sizes        ProductSize[]
  specs        ProductSpec[]
  downloads    ProductDownload[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int     @default(0)
}

model ProductColorOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  // Real swatch photo (e.g. a wood/fabric finish shot) - takes priority over
  // the flat hex circle on the client when present.
  imagePath String?
  sortOrder Int     @default(0)
}

// Real dimension/size variants (e.g. "W1200 X D740 X H750 MM") - a product
// with none of these rows never shows a Size section on the client, instead
// of the old hardcoded SIZES list every product used to show regardless of
// fit.
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int     @default(0)
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)
}

model ProductDownload {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  kind      String
  filePath  String
  sortOrder Int     @default(0)
}

model Quote {
  id             String      @id @default(cuid())
  // Nullable so an anonymous visitor can build a quote with no account at
  // all before submitting - anonymousSessionId identifies them instead (see
  // lib/anonSession.ts). Exactly one of clientId/anonymousSessionId is set
  // until reparentAnonymousSession() (app/actions/auth.ts) re-parents the
  // row onto a real account at sign up/in - required before submission, so
  // a submitted quote always has a clientId.
  clientId       String?
  client         User?       @relation("ClientQuotes", fields: [clientId], references: [id])
  anonymousSessionId String?
  // Manually entered by a contractor building this quote for their own end
  // client (see contractorSetClientContact in app/actions/quotes.ts) - that
  // client never gets a PickTheBrick account, so this is purely a label/
  // record, not tied to a User row. Otherwise not written anywhere (a real
  // client submission requires a real account) - contactPhone/contactEmail
  // also double as a future OTP-verified WhatsApp capture step and a display
  // fallback (see lib/contactLabel.ts).
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  status         QuoteStatus @default(draft)
  location       String?
  officeSize     String?
  captainId      String?
  captain        User?       @relation("CaptainQuotes", fields: [captainId], references: [id])
  contractorId   String?
  contractor     User?       @relation("ContractorQuotes", fields: [contractorId], references: [id])
  // Set the first time the contractor downloads this quote's PDF (see
  // contractorMarkQuoteCompleted in app/actions/quotes.ts) - the "quote
  // created" event the admin contractor-quotes tab counts. Only meaningful
  // when contractorId is set; status stays `draft` forever for these quotes
  // since they never enter the real PTB pipeline (see createContractorQuote).
  contractorCompletedAt DateTime?
  // Soft-delete for a contractor's own quote: set when they click Delete on
  // their dashboard, which just hides it from that list (app/contractor/page.tsx
  // filters on this) instead of removing the row - these are kept as a backup/
  // audit record even after the contractor "deletes" one, since we may bill
  // per quote later. deleteContractorQuote never hard-deletes anymore.
  contractorHiddenAt    DateTime?
  materialsTotal Float       @default(0)
  installTotal   Float       @default(0)
  grandTotal     Float       @default(0)
  // Client-facing daily-sequential reference number, DD/MM/YY/NN, assigned
  // once the quote is submitted - null for quotes still in draft.
  referenceNumber String?    @unique
  createdAt      DateTime    @default(now())
  submittedAt    DateTime?
  confirmedAt    DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?

  items         QuoteItem[]
  statusHistory QuoteStatusHistory[]

  progress     ProjectProgress?
  inspections  SiteInspectionRequest[]
  paymentClaims PaymentClaim[]
  projectContractors ProjectContractor[]
  timelineItems ProjectTimelineItem[]
  aiAssistSessions AiAssistSession[]
}

// One row per AI Assist run on the Build page (see app/actions/aiAssist.ts) -
// the intake + what was suggested + what the client actually kept, snapshotted
// as JSON strings rather than live product FKs. Snapshotting matters here
// specifically because the catalog is expected to churn heavily in the first
// running month (products uploaded now are placeholders) - a log row must
// still read sensibly after the product it referenced is gone, so this is
// the "learning as an asset" trail (lib/aiAssist.ts formulas + prompt can be
// tuned against these later) rather than a live relation.
model AiAssistSession {
  id                 String   @id @default(cuid())
  quoteId            String?
  quote              Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  clientId           String?
  anonymousSessionId String?
  officeSize         Float?
  spacesJson         String
  style              String?
  tier               String?
  // "manual" (typed into the intake form) or "designSurvey" (pulled from an
  // existing DesignRequest + StyleFinderResult) - which reuse path was used.
  source             String
  // Whether the live Claude call ran or the deterministic no-API-key
  // fallback did - lets a later analysis separate "AI picked this" accuracy
  // from "we just picked the featured product" accuracy.
  usedAi             Boolean  @default(false)
  suggestionsJson    String
  acceptedJson       String?
  createdAt          DateTime @default(now())
}

model QuoteItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  // Denormalized snapshot of the category at quote time, kept even if the
  // catalog category is later renamed/removed. categoryId is the live FK,
  // added later so it's null on items created before this field existed.
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  name          String
  categoryLabel String
  typeLabel     String
  subtypeLabel  String
  rate          Float
  installRate   Float    @default(0)
  unit          Unit
  qty           Float
  amount        Float

  @@unique([quoteId, productId])
}

model QuoteStatusHistory {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
}

// A client's design-package survey (package + sqft + spaces), tracked from
// the moment they start the flow through the designer delivering files back.
model DesignRequest {
  id           String              @id @default(cuid())
  // Nullable for the same reason as Quote.clientId above - an anonymous
  // visitor is identified by anonymousSessionId instead until they claim
  // the request onto a real account.
  clientId     String?
  client       User?               @relation("ClientDesignRequests", fields: [clientId], references: [id])
  anonymousSessionId String?
  contactPhone String?
  contactEmail String?
  packageKey   String
  sqft         Float
  spaces       String              @default("")
  status       DesignRequestStatus @default(draft)
  designerId   String?
  designer     User?               @relation("DesignerAssignments", fields: [designerId], references: [id])
  designerNote String?
  // Snapshot of the package price computed from packageKey+sqft at the
  // moment the request was started (see lib/designPricing.ts) - the client
  // dashboard/checkout screens read this instead of recomputing, since the
  // pricing table could change later without altering an already-started request.
  packagePrice Float?
  // Set when the client has no layout of their own and instead requests a
  // captain-arranged site visit (AED 500, added to packagePrice for the total).
  siteVisitRequested Boolean @default(false)
  siteVisitFee       Float   @default(0)
  // The client's preferred date for the site visit, picked on the handover
  // screen before proceeding to checkout - purely informational for the
  // captain, who arranges the actual visit (see app/actions/design.ts's
  // requestSiteVisit and the captain's own site-inspection scheduling in
  // app/actions/progress.ts, which is a separate, later-stage concept).
  siteVisitPreferredDate DateTime?
  // Payment method chosen on the post-handover checkout screen - UI + manual
  // record only, no gateway is wired up; admin reconciles cash/pay-later offline.
  paymentMethod           String?
  paymentMethodSelectedAt DateTime?
  createdAt    DateTime            @default(now())
  submittedAt  DateTime?
  assignedAt   DateTime?
  // 48 hours after assignedAt, whether from a designer self-claim or an
  // admin assignment - informational only (see AdminDesignerClient.tsx /
  // DesignerClient.tsx overdue highlighting), nothing auto-reassigns.
  claimDeadline DateTime?
  deliveredAt  DateTime?

  // How many times the designer has delivered/redelivered a submittal via
  // submitDesignRevision (app/actions/design.ts) - capped per package (see
  // MAX_REVISIONS in lib/designPricing.ts). lastRevisionAt gates the next
  // upload behind a logged client comment (see DesignRequestRevisionComment).
  revisionsUsed  Int       @default(0)
  lastRevisionAt DateTime?

  files            DesignRequestFile[]
  spaceEntries     DesignRequestSpace[]
  revisionComments DesignRequestRevisionComment[]
}

// A running log of client<->designer communication about a delivered
// revision - the designer is required to log a comment here (their own
// summary if the feedback came via a phone/Zoom call, channel="call")
// before uploading the next revision, so there's always a record of what
// was discussed in case of a future dispute. Visible to the client,
// designer, and admin.
model DesignRequestRevisionComment {
  id              String        @id @default(cuid())
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  authorRole      String
  body            String
  channel         String        @default("text")
  createdAt       DateTime      @default(now())
}

model DesignRequestFile {
  id              String        @id @default(cuid())
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  label           String
  filePath        String
  sortOrder       Int           @default(0)
  // The uploading designer can self-delete only within a 10-minute window of
  // this timestamp (see DESIGNER_DELETE_WINDOW_MS in app/actions/design.ts) -
  // after that, only an admin can remove the file.
  createdAt       DateTime      @default(now())
}

// One row per space *instance* the client added on the Spaces step (so 2
// Executive Cabins = 2 rows), each answered independently in the Features
// wizard.
model DesignRequestSpace {
  id              String  @id @default(cuid())
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)
  spaceKey        String
  sortOrder       Int     @default(0)
  notes           String?

  answers DesignRequestSpaceAnswer[]
}

model DesignRequestSpaceAnswer {
  id                   String             @id @default(cuid())
  designRequestSpaceId String
  designRequestSpace   DesignRequestSpace @relation(fields: [designRequestSpaceId], references: [id], onDelete: Cascade)
  questionKey          String
  value                String

  @@unique([designRequestSpaceId, questionKey])
}

// One per client/anonymous session - the swipe-quiz result from the Style
// Finder widget (see lib/styleFinder.ts, app/design/style-finder/). Keyed on
// the actor (clientId or anonymousSessionId), NOT a specific DesignRequest -
// it's a property of the person, not any one survey, so it's takeable
// before/during/without a design request and applies to all of a client's
// requests. Same nullable-dual-actor pattern as DesignRequest/Quote above
// (see lib/actor.ts); claimAnonymousSession() re-parents anonymousSessionId
// -> clientId on signup/signin, same as it does for Quote/DesignRequest.
// Retaking the quiz replaces this row and its stats rather than keeping
// history. Visible read-only to a designer via the client on their assigned
// request (see app/designer/DesignerClient.tsx).
model StyleFinderResult {
  id                 String  @id @default(cuid())
  clientId           String? @unique
  anonymousSessionId String? @unique
  // Denormalized winner style key (or null if no confident pick) - same
  // snapshot reasoning as DesignRequest.packagePrice above.
  topStyle    String?
  completedAt DateTime @default(now())

  stats StyleFinderStat[]
}

model StyleFinderStat {
  id                  String            @id @default(cuid())
  styleFinderResultId String
  styleFinderResult   StyleFinderResult @relation(fields: [styleFinderResultId], references: [id], onDelete: Cascade)
  styleKey            String
  shown               Int
  liked               Int
}

// Marketer-uploaded photography for the Style Finder swipe deck (see
// lib/styleFinder.ts) - one row per (style, slot 0..IMAGES_PER_STYLE-1).
// Any slot left empty falls back to a picsum.photos placeholder, same
// per-slot-optional pattern as SpaceLayerImage above.
model StyleFinderImage {
  id       String @id @default(cuid())
  styleKey String
  slot     Int
  imageUrl String

  @@unique([styleKey, slot])
}

// Marketing banners, managed by Admin, shown on the Client build page.
model Banner {
  id        String   @id @default(cuid())
  imagePath String
  linkUrl   String?
  title     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// A contractor's self-submitted application to partner with PickTheBrick -
// which catalog categories they can work in plus a trade license, pending
// admin approval before the account can be assigned to any project.
model ContractorApplication {
  id              String                       @id @default(cuid())
  contractorId    String                       @unique
  contractor      User                         @relation(fields: [contractorId], references: [id])
  licenseFilePath String
  // Business details captured on the "become a partner" form - specific to
  // this application (not the account itself), so re-applying after a
  // rejection can update them.
  companyName     String?
  contactPhone    String?
  officeLocation  String?
  status          ContractorApplicationStatus  @default(pending)
  submittedAt     DateTime                     @default(now())
  reviewedAt      DateTime?
  reviewNote      String?
  // When the contractor accepted the Partner Terms & Conditions - captured
  // for audit purposes each time they (re)submit (see lib/contractorTerms.ts).
  agreedTermsAt   DateTime?

  categories ContractorApplicationCategory[]
  types      ContractorApplicationType[]
}

model ContractorApplicationCategory {
  id            String                 @id @default(cuid())
  applicationId String
  application   ContractorApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category               @relation(fields: [categoryId], references: [id])

  @@unique([applicationId, categoryId])
}

// Type-level expertise within an approved category - e.g. a contractor
// approved for "Flooring" might only cover "Tiles", not "Carpet". Required
// going forward: every checked category must have at least one type here
// (see submitContractorApplication in app/actions/contractors.ts). Contractor
// assignment eligibility (assertAssignableContractor in app/actions/timeline.ts)
// checks this table, not just ContractorApplicationCategory.
model ContractorApplicationType {
  id            String                @id @default(cuid())
  applicationId String
  application   ContractorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  typeId        String
  type          Type                  @relation(fields: [typeId], references: [id])

  @@unique([applicationId, typeId])
}

// A designer's self-application to partner with PickTheBrick - mirrors
// ContractorApplication's shape/status workflow (see app/actions/designers.ts).
// This is project-based freelance work, not employment - see the copy on
// app/designer/apply/page.tsx.
model DesignerApplication {
  id             String                     @id @default(cuid())
  designerId     String                     @unique
  designer       User                       @relation(fields: [designerId], references: [id])
  knowsRevit     Boolean                    @default(false)
  location       String?
  country        String?
  whatsappNumber String?
  portfolioUrl   String?
  cvFilePath     String?
  status         DesignerApplicationStatus  @default(pending)
  submittedAt    DateTime                   @default(now())
  reviewedAt     DateTime?
  reviewNote     String?
  agreedTermsAt  DateTime?
}

// Delivery/site-work progress on a confirmed project - each dimension is
// reported by the contractor and separately approved (signed off) by the
// captain; only the approved values count toward payment eligibility.
model ProjectProgress {
  id               String   @id @default(cuid())
  quoteId          String   @unique
  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  deliveryReported Int      @default(0)
  deliveryApproved Int      @default(0)
  siteReported     Int      @default(0)
  siteApproved     Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model SiteInspectionRequest {
  id          String                @id @default(cuid())
  quoteId     String
  quote       Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status      SiteInspectionStatus  @default(requested)
  note        String?
  // The contractor's requested date when they raised this (null when the
  // captain created the visit directly - see createSiteInspection). The
  // captain can pick a different scheduledAt when accepting.
  preferredDate DateTime?
  scheduledAt DateTime?
  captainNote String?
  requestedAt DateTime              @default(now())
  // The captain's write-up of what they found on site, entered once the
  // visit is marked completed - frozen after being set (see
  // recordSiteVisitNotes in app/actions/progress.ts), unlike captainNote
  // above which is just scheduling context and can be overwritten anytime.
  visitNotes           String?
  visitNotesRecordedAt DateTime?
}

// One contractor assigned to one catalog category within a project - a
// project can have several (drywall, flooring, etc.), each tracked
// independently; overall project progress is the average across all of them.
model ProjectContractor {
  id               String    @id @default(cuid())
  quoteId          String
  quote            Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  contractorId     String
  contractor       User      @relation(fields: [contractorId], references: [id])
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  deliveryReported Int       @default(0)
  deliveryApproved Int       @default(0)
  siteReported     Int       @default(0)
  siteApproved     Int       @default(0)
  assignedAt       DateTime  @default(now())

  @@unique([quoteId, categoryId])
}

// One row of a project's timeline (Gantt-style) - captain (or admin) types
// a label plus a start/end date; the UI draws a bar from these, no
// drag/resize interaction. Cascade-deleted with the quote.
//
// Also the unit of contractor assignment (replacing the old per-category
// ProjectContractor flow - see assignTimelineItemContractor in
// app/actions/timeline.ts): category/type/contractor are set together via
// the Assign button, flipping status to `assigned`, at which point the
// delivery/site progress fields below become editable (contractor reports,
// captain/admin approves - same shape ProjectContractor used to track).
model ProjectTimelineItem {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label     String
  startDate DateTime
  endDate   DateTime
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  typeId       String?
  type         Type?     @relation(fields: [typeId], references: [id])
  contractorId String?
  contractor   User?     @relation(fields: [contractorId], references: [id])
  status       TimelineItemStatus @default(unassigned)

  deliveryReported Int @default(0)
  deliveryApproved Int @default(0)
  siteReported     Int @default(0)
  siteApproved     Int @default(0)

  applications TimelineItemApplication[]
}

// A contractor expressing interest in an unassigned timeline item they're
// type-approved for (see the "Open jobs" tab in app/contractor/ContractorClient.tsx
// and applyForOpenJob in app/actions/timeline.ts) - purely informational,
// surfaced to the captain/admin as a marker in the Contractor picker
// (GanttChart.tsx) so applicants can be given priority; doesn't block the
// captain/admin from assigning anyone else who's type-approved.
model TimelineItemApplication {
  id             String              @id @default(cuid())
  timelineItemId String
  timelineItem   ProjectTimelineItem @relation(fields: [timelineItemId], references: [id], onDelete: Cascade)
  contractorId   String
  contractor     User                @relation(fields: [contractorId], references: [id])
  appliedAt      DateTime            @default(now())

  @@unique([timelineItemId, contractorId])
}

// A contractor's request to draw down payment against currently
// captain-approved progress - snapshots the eligible percent/amount at
// request time; admin resolves it (mirrors the existing markQuotePaid flow).
// Editable copy for every outbound notification event - one row per event
// key (e.g. "captain_assigned"), holding both channels' text so admin has a
// single place to edit a given event's messaging. Seeded from the copy that
// used to be hardcoded in lib/email.ts; sendTemplatedEmail/sendTemplatedWhatsApp
// read from here at send time, interpolating {{placeholders}}.
model NotificationTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  label        String
  emailSubject String
  emailBody    String
  whatsappBody String
  updatedAt    DateTime @updatedAt
}

model PaymentClaim {
  id               String             @id @default(cuid())
  quoteId          String
  quote            Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedPercent Int
  requestedAmount  Float
  status           PaymentClaimStatus @default(pending)
  note             String?
  requestedAt      DateTime           @default(now())
  resolvedAt       DateTime?
}

// A career vacancy, managed from the admin Careers tab - shown publicly on
// /careers. Applications reference the posting by id but also snapshot its
// title (jobTitle on JobApplication), so a deleted/closed posting never
// breaks an already-submitted application's record.
model JobPosting {
  id             String   @id @default(cuid())
  title          String
  department     String?
  location       String?
  employmentType String?
  description    String
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id           String      @id @default(cuid())
  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  // Snapshot of the posting's title at application time - survives the
  // posting being edited or removed later.
  jobTitle     String
  fullName     String
  email        String
  phone        String?
  coverNote    String?
  cvPath       String
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

// Singleton row (fixed id "ai-designer-banner") backing the joke "AI
// Designer" banner on /design - editable from the admin Marketing tab so
// marketing can change its copy or turn it off without a code change.
model AiDesignerBanner {
  id              String  @id @default("ai-designer-banner")
  headline        String  @default("AI Designer")
  subText         String  @default("Humans are the best.....But AI designer is coming soon!!!")
  popupMessage    String  @default("Our human designers are still better at it.")
  backgroundColor String  @default("#fffcf5")
  enabled         Boolean @default(true)
}

// One fixed row per homepage "Built with PickTheBrick" case-study card (ids
// "case-1".."case-3", matching CASE_STUDIES' order in HomeClient.tsx) -
// marketing can swap in a real project photo and point the card's button at
// a real link, without touching code. Tag/title/stats/rating text stay
// hardcoded in HomeClient.tsx since only the photo + button were asked to be
// editable here.
model CaseStudyCard {
  id          String  @id
  imageUrl    String?
  buttonLabel String  @default("View project")
  buttonUrl   String  @default("/build")
}

// Marketer-uploaded artwork for the Design flow's per-space visuals - one row
// per (space, slot). `slot` is one of:
//   "button"                          - the space-picker card image (SpacesSurvey.tsx)
//   "base"                            - always-on room image (FeaturesWizard.tsx)
//   "feature:<questionKey>"           - shown while that boolean switch is on
//   "choice:<questionKey>:<value>"    - shown while that choice option is selected
// (see lib/spaceLayers.ts, which is the only place that builds/parses slot
// strings, and lib/spaceQuestions.ts for the questionKey/value vocabulary).
// Every slot is optional - client-facing code falls back to the hand-drawn
// SpaceIcon SVG for any space/slot that hasn't been uploaded yet.
model SpaceLayerImage {
  id        String @id @default(cuid())
  spaceKey  String
  slot      String
  imageUrl  String
  // Stacking order within a space - resolveLayerImages() renders layers in
  // this order so a marketer can fix wrong overlapping (e.g. a rug should
  // render under a desk, not over it) without touching code.
  sortOrder Int    @default(0)

  @@unique([spaceKey, slot])
}

// Admin-added boolean question for a space, on top of the fixed set in
// lib/spaceQuestions.ts (SPACE_QUESTIONS) - lets a marketer open up a new
// client-selectable option (e.g. "Bean bag seating") without a code change.
// Always boolean (a plain yes/no toggle, same shape as the hardcoded
// questions) - merged with the hardcoded list at render time via
// mergedSpaceQuestions() rather than replacing it. `key` is a generated
// slug, namespaced with a "custom_" prefix so it can never collide with a
// hardcoded question key.
model SpaceCustomQuestion {
  id        String   @id @default(cuid())
  spaceKey  String
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([spaceKey, key])
}

// Marks a hardcoded boolean question from SPACE_QUESTIONS (lib/spaceQuestions.ts)
// as deleted for a given space - the question itself lives in code and can't
// be removed from the database, so this is the admin-facing equivalent of
// deleting a SpaceCustomQuestion row: mergedSpaceQuestions() filters it out
// everywhere (the survey, the layer-image slots, the SpaceIcon feature-layer
// toggle), so it stops being asked/shown/uploadable entirely. Choice-type
// questions (chair/desk counts) are structural and aren't hideable this way.
model SpaceQuestionHidden {
  id       String @id @default(cuid())
  spaceKey String
  key      String

  @@unique([spaceKey, key])
}

enum PackageTier {
  essential
  advanced
  premium
}

// One row per feature line shown in the package cards on /design (see
// lib/packageFeatures.ts for the default seed list and the
// featureItemsForTier() filter). `minTier` is the lowest package that
// includes this item - Advanced shows every essential+advanced item,
// Premium shows all three tiers - mirroring the old hardcoded
// ESSENTIAL_FEATURES/ADVANCED_FEATURES/PREMIUM_FEATURES arrays this
// replaced. `description` is shown as a hover tooltip; `sampleImageUrl`
// gates the client-facing "Sample" button - both are optional and editable
// from the admin/marketing Design package features panel.
model PackageFeatureItem {
  id             String      @id @default(cuid())
  label          String
  description    String?
  minTier        PackageTier
  sortOrder      Int         @default(0)
  sampleImageUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// A single task row on the /admin/brain "Checklist" page - the one
// genuinely functional (non-sample) piece of that internal workspace.
// Shared across whoever's signed in as super_admin (DB-backed rather than
// localStorage, so it's the same list on any device), seeded once with 8
// starter rows on first load (see app/admin/brain/page.tsx).
model BrainChecklistItem {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Singleton row (fixed id, see lib/marketingState.ts) holding the Marketing
// employee's global autonomy level and per-tool permissions - shared source
// of truth for both the Approvals page and the chat agent's tool calls, so
// changing autonomy in chat is reflected in the UI and vice versa.
model MarketingWorkspaceState {
  id                 String    @id @default(cuid())
  autonomyLevel      Int       @default(1)
  permissionsJson    String    @default("{}")
  // Last-run analysis summary bullets (the recommendations themselves live
  // in MarketingRecommendation, since those need individual ids/status) -
  // cached here so re-opening the Overview page shows the last analysis
  // without an LLM call; only "Refresh analysis" (or the first-ever visit,
  // when this is still empty) triggers a new one.
  workingJson        String    @default("[]")
  problemsJson       String    @default("[]")
  analysisUpdatedAt  DateTime?
  // Growth Manager's latest opportunity list - same cache-until-refreshed
  // shape as working/problems above.
  opportunitiesJson       String    @default("[]")
  opportunitiesUpdatedAt  DateTime?
  updatedAt          DateTime  @updatedAt
}

// The AI Marketing Manager's current batch of recommendations - persisted
// (not regenerated-and-thrown-away) so the chat agent can approve/reject a
// specific recommendation by id and have the Overview page reflect it.
// Replaced wholesale each time a fresh analysis runs (see
// lib/marketingState.ts replaceRecommendations()). Doubles as the generic
// action-execution object (see lib/ai/actionExecutor.ts): approving a row
// only ever changes `status` here, it never touches an external service -
// only executeAction() does that, via the fields below. status is one of
// RECOMMENDED | APPROVED | REJECTED | EXECUTING | EXECUTED | FAILED |
// CANCELLED. type is "advisory" (no external effect, the historical/default
// case) or a tool name like "google_ads.create_campaign".
model MarketingRecommendation {
  id                   String    @id @default(cuid())
  title                String
  why                  String
  impact               String
  risk                 String
  status               String    @default("RECOMMENDED")
  type                 String    @default("advisory")
  externalService      String?
  externalId           String?
  requestPayloadJson   String?
  resultJson           String?
  error                String?
  mock                 Boolean   @default(true)
  approvedAt           DateTime?
  executionStartedAt   DateTime?
  executionCompletedAt DateTime?
  createdAt            DateTime  @default(now())
}

// Standing instructions the founder has given the Marketing employee (e.g.
// "always flag CPL spikes over 20%") - durable rules folded into the system
// prompt on every chat/analysis call, distinct from one-off chat messages.
model MarketingInstruction {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

// One global conversation thread with the Marketing employee - shared by the
// floating assistant popup and the full Chat tab (same employee, same
// conversation, viewed two ways). toolCallsJson records which tools (if any)
// fired while producing an assistant turn, shown as a small trace in the UI.
model MarketingChatMessage {
  id            String   @id @default(cuid())
  role          String
  content       String
  toolCallsJson String?
  createdAt     DateTime @default(now())
}

// A visitor's conversation with the public /ask-ai assistant (see
// app/actions/assistant.ts) - identified by the same actor pattern as
// Build/Design (lib/actor.ts): a signed-in client's id, or an anonymous
// visitor's ptb_anon cookie id (lib/anonSession.ts). Exactly one of
// clientId/anonymousSessionId is set. Persisted so a conversation survives a
// reload or return visit, and so the assistant's own past replies to this
// visitor are folded back into context on the next turn.
model SiteAssistantMessage {
  id                 String   @id @default(cuid())
  clientId           String?
  anonymousSessionId String?
  role               String
  content            String
  createdAt          DateTime @default(now())

  @@index([clientId])
  @@index([anonymousSessionId])
}

// The Performance Analyst's latest read on one channel - replaces the old
// static GOOGLE_INSIGHTS/META_INSIGHTS/CONVERSION_INSIGHTS arrays with a
// real per-channel analysis, cached until "Refresh insights" (or the
// Marketing Manager delegating via the analyze_performance tool) reruns it.
model MarketingChannelInsight {
  id           String   @id @default(cuid())
  channel      String   @unique
  insightsJson String
  fallback     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// One Reporting Manager output - daily/weekly reports accumulate as a
// history rather than being overwritten, so past reports stay browsable.
model MarketingReport {
  id        String   @id @default(cuid())
  period    String
  content   String
  fallback  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// One row per OpenAI call the Marketing employee makes - this app's own
// cost-tracking/hard-stop layer (lib/marketingBudget.ts), independent of
// (and more reliable than) OpenAI's own project-level budget, which is a
// soft threshold that doesn't always block requests once exceeded.
model MarketingAiUsage {
  id               String   @id @default(cuid())
  role             String   // "manager" | "analyst" | "content" | "growth" | "reporting"
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// Singleton row (fixed id, see lib/marketingBudget.ts) holding the
// founder's spend caps, checked before every OpenAI call. Defaults match
// the founder's own starting numbers - conservative until real usage data
// justifies raising them.
model MarketingBudget {
  id                   String @id @default(cuid())
  dailyCapUsd          Float  @default(3)
  monthlyCapUsd        Float  @default(50)
  maxSingleCallUsd     Float  @default(0.5)
  warningThresholdUsd  Float  @default(25)
  criticalThresholdUsd Float  @default(40)
}

// The Marketing team's shared "constitution" - permanent business knowledge
// every role's system prompt is built from (see buildBusinessContext() in
// lib/ai/marketingProvider.ts), editable from the Knowledge Base tab
// instead of requiring a code change. Singleton row (fixed id), plain text
// per section rather than nested JSON - it's just a form of textareas.
model MarketingConstitution {
  id              String   @id @default(cuid())
  business        String
  customers       String
  products        String
  objectives      String
  brandRules      String
  commercialRules String
  updatedAt       DateTime @updatedAt
}
